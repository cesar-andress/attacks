{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cesar-andress/attacks/schemas/document.schema.json",
  "title": "Document candidate (L1) — provisional register v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "framework_id",
    "title",
    "relationship_type",
    "redistribution_status",
    "local_file_status",
    "identity_status",
    "screening_status",
    "provenance_confidence"
  ],
  "properties": {
    "document_id": { "type": "string", "minLength": 1 },
    "framework_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "publication_date": { "type": "string" },
    "retrieval_date": { "type": "string" },
    "source_url": { "type": "string" },
    "source_domain_text": { "type": "string" },
    "language": { "type": "string" },
    "document_type": {
      "type": "string",
      "enum": [
        "guideline",
        "assessment_tool",
        "standard",
        "regulatory_instrument",
        "annex",
        "other",
        "placeholder"
      ]
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "primary_document",
        "companion_assessment_tool",
        "implementation_guide",
        "appendix_or_annex",
        "regulatory_instrument",
        "related_but_independent_framework",
        "placeholder_unverified"
      ]
    },
    "is_primary_document": {
      "type": "string",
      "enum": ["yes", "no", ""]
    },
    "redistribution_status": {
      "type": "string",
      "enum": [
        "unknown",
        "prohibited",
        "permitted",
        "public_domain",
        "fair_use_excerpts_only"
      ]
    },
    "local_file_status": {
      "type": "string",
      "enum": ["none", "local_ignored", "tracked_open"]
    },
    "checksum_sha256": { "type": "string" },
    "page_count": { "type": ["integer", "string", "null"] },
    "word_count": { "type": ["integer", "string", "null"] },
    "identity_status": {
      "type": "string",
      "enum": [
        "candidate_verified_identity",
        "candidate_partly_verified",
        "candidate_unverified",
        "excluded_before_full_text"
      ]
    },
    "screening_status": {
      "type": "string",
      "enum": [
        "not_screened",
        "uncertain_pending_full_text",
        "likely_eligible",
        "likely_ineligible"
      ]
    },
    "provenance_confidence": {
      "type": "string",
      "enum": [
        "verified_official_source",
        "partly_verified",
        "known_not_reverified",
        "provisional_to_locate"
      ]
    },
    "unresolved_verification_action": { "type": "string" },
    "exclusion_or_uncertainty_concern": { "type": "string" },
    "document_notes": { "type": "string" }
  }
}
