{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cesar-andress/attacks/schemas/document.schema.json",
  "title": "Document (L1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "framework_id",
    "title",
    "redistribution_status",
    "local_file_status",
    "inclusion_status"
  ],
  "properties": {
    "document_id": { "type": "string", "minLength": 1 },
    "framework_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "publication_date": {
      "type": "string",
      "description": "ISO-8601 date or empty"
    },
    "retrieval_date": { "type": "string" },
    "source_url": { "type": "string" },
    "language": { "type": "string" },
    "document_type": {
      "type": "string",
      "enum": ["guideline", "assessment_tool", "standard", "other"]
    },
    "redistribution_status": {
      "type": "string",
      "enum": [
        "unknown",
        "prohibited",
        "permitted",
        "public_domain",
        "fair_use_excerpts_only"
      ]
    },
    "local_file_status": {
      "type": "string",
      "enum": ["none", "local_ignored", "tracked_open"]
    },
    "checksum_sha256": { "type": "string" },
    "page_count": {
      "type": ["integer", "string", "null"],
      "description": "Integer or empty string in CSV round-trips"
    },
    "word_count": {
      "type": ["integer", "string", "null"],
      "description": "Optional; sensitivity analyses only"
    },
    "inclusion_status": {
      "type": "string",
      "enum": ["included", "excluded", "candidate", "deferred"]
    },
    "exclusion_reason": { "type": "string" }
  }
}
