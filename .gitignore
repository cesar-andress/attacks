*~

# Local copyrighted source documents (metadata + URLs only in public repo)
data/sources/
data/pdfs/
*.pdf
*.PDF
*.docx
*.DOCX

# Private notes and adjacent private directories (never track)
private/
private_admin/
notes/
*.local.md
../paper/
../../paper/

# Generated / scratch analysis outputs (keep templates; ignore local runs)
data/derived/**
!data/derived/.gitkeep
data/reliability/**/*
!data/reliability/.gitkeep
!data/reliability/README.md
experiments/_generated/

# Temporary and OSF/local sync clutter
tmp/
temp/
.cache/
*.tmp
*.bak
~$*

# Authorized local full-text (not for public redistribution by default)
local_sources/

# Generated coder packages and live submissions (regenerate; do not commit contents)
data/phase_b/generated_packages/**
!data/phase_b/generated_packages/.gitkeep
data/phase_b/coder_submissions/**
!data/phase_b/coder_submissions/.gitkeep
!data/phase_b/coder_submissions/README.md

# Completed operational records with personal data (templates stay public)
data/operations/completed/
data/operations/*_filled.csv
!data/operations/*_template.csv
!data/operations/execution_dashboard.csv
!data/operations/release_matrix.csv
!data/operations/README.md
